# Modo simple: una DB compartida, schema `public` para todos los microservicios.
# Usar el session pooler de Supabase (puerto 5432); el transaction pooler (6543)
# puede romper prepared statements de SQLx.
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_MAX_CONNECTIONS=10

SERVER_PORT=3000

# JWT: este servicio SOLO verifica tokens emitidos por auth-service (no los firma).
# Asumimos HS256 con secret compartido. Si auth-service cambia a RS256,
# reemplazar JWT_SECRET por JWT_PUBLIC_KEY y ajustar shared/jwt.rs.
JWT_SECRET=your_jwt_secret_here
JWT_ISSUER=coworking-auth
JWT_AUDIENCE=coworking

AUTH_SERVICE_URL=http://localhost:8000

RUST_LOG=info,checking_service=debug

# Compilar sin DB usando el cache .sqlx/ commiteado. Útil en CI y para compañeros sin acceso.
# SQLX_OFFLINE=true
